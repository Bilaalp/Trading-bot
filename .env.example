# Copy to .env and fill in — or export these in your shell.
# NEVER commit real keys. .env is gitignored.
#
# Only needed for LIVE trading. Backtesting and paper trading work without keys.
# Create keys on your exchange with TRADE permission only — never enable
# withdrawals for bot keys — and restrict them to your server's IP if possible.

EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
